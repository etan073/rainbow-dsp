import sounddevice as sd
import numpy as np
import matplotlib.pyplot as plt
from matplotlib.animation import FuncAnimation
import matplotlib.cm as cm

# Ses ayarları
CHUNK = 2048     
RATE = 44100     

# Gürültü engelleme eşiği (0.01 ile 0.1 arasında mikrofonuna göre değiştirebilirsin)
NOISE_THRESHOLD = 0.03  

# Grafik ayarları
fig, ax = plt.subplots(figsize=(10, 5))
fig.canvas.manager.set_window_title('Gürültü Engellemeli Ses Grafiği')
fig.patch.set_facecolor('black')
ax.set_facecolor('black')

# Eksen ayarları
x = np.arange(0, CHUNK)
line, = ax.plot(x, np.zeros(CHUNK), '-', lw=2)
ax.set_ylim(-1, 1) 
ax.set_xlim(0, CHUNK)
ax.set_xlabel("Zaman", color='white')
ax.set_ylabel("Genlik", color='white')
ax.tick_params(colors='white')

# Renk haritası 
cmap = plt.get_cmap('rainbow') 
MIN_FREQ = 80.0
MAX_FREQ = 800.0

audio_data = np.zeros(CHUNK)

def audio_callback(indata, frames, time, status):
    global audio_data
    audio_data = indata[:, 0]

def update(frame):
    global audio_data
    
    # Sesin maksimum genliğini (şiddetini) ölç
    max_amplitude = np.max(np.abs(audio_data))
    
    # Eğer ses şiddeti gürültü eşiğinin altındaysa, dalgayı sıfırla (düz çizgi)
    if max_amplitude < NOISE_THRESHOLD:
        line.set_ydata(np.zeros(CHUNK))
        return line,
    
    # Eşiği geçen bir ses varsa dalgayı çiz
    line.set_ydata(audio_data)
    
    # Frekans hesaplama (FFT)
    fft_data = np.abs(np.fft.rfft(audio_data))
    freqs = np.fft.rfftfreq(CHUNK, 1.0/RATE)
    
    # Sadece en düşük frekanslı dip sesleri filtreleyerek baskın frekansı bul
    # 0. indeksteki DC bileşenini ve çok düşük frekanslı gürültüleri (ilk 5 indeks) atla
    dom_freq_idx = np.argmax(fft_data[5:]) + 5
    dom_freq = freqs[dom_freq_idx]
    
    # Frekansı normalize et (Renk haritası için)
    norm_freq = (dom_freq - MIN_FREQ) / (MAX_FREQ - MIN_FREQ)
    norm_freq = max(0.0, min(1.0, norm_freq))
    
    # Çizgi rengini güncelle
    line.set_color(cmap(norm_freq))
        
    return line,

print("Mikrofon dinleniyor... Kapatmak için grafik penceresini kapatın.")
try:
    stream = sd.InputStream(channels=1, samplerate=RATE, blocksize=CHUNK, callback=audio_callback)
    with stream:
        ani = FuncAnimation(fig, update, interval=20, blit=True, cache_frame_data=False)
        plt.show()
except Exception as e:
    print(f"Bir hata oluştu: {e}")